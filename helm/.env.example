# GitHub Container Registry pull secret configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Uses the same credentials as edc/helm/edc (cx-registry-pull-secret).

# Kubernetes namespace for the demonstrator release
# NAMESPACE=cx-uc-demonstrator

# Secret name (default: cx-registry-pull-secret)
# SECRET_NAME=cx-registry-pull-secret

# Registry URL (default: ghcr.io)
# REGISTRY=ghcr.io

# GitHub username (required)
GITHUB_USER=your-github-username

# GitHub Personal Access Token with read:packages scope (required)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Set to true for dry run (no changes applied)
# DRY_RUN=false

# Set to true to overwrite existing secret without prompt
# FORCE=false

# kubectl context (default: eecc-prod)
# KUBE_CONTEXT=eecc-prod
