# Dev image — requires backend to be initialized first (requirements.txt + FastAPI app).
# Source is bind-mounted at runtime; uvicorn --reload picks up changes without container restart.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000

# Adjust module path if project init uses a different layout (e.g. main:app)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app"]
