# Dev image — whole ./backend is bind-mounted to /backend at runtime.
# Entrypoint creates .venv inside the mounted folder when missing.
FROM python:3.12-slim

WORKDIR /backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt docker-entrypoint.dev.sh ./
RUN chmod +x docker-entrypoint.dev.sh

EXPOSE 8000

ENTRYPOINT ["./docker-entrypoint.dev.sh"]
