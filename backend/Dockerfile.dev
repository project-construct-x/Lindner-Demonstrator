# Dev image — requires backend to be initialized first (requirements.txt + FastAPI app).
# Source is bind-mounted at runtime; uvicorn --reload picks up changes without container restart.
FROM python:3.12-slim

WORKDIR /backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/backend"]
