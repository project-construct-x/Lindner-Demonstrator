# Dev image — whole ./frontend is bind-mounted to /frontend at runtime.
# Uses Debian-based Node (glibc) so native deps match Ubuntu host when shared via bind mount.
FROM node:24-bookworm-slim

WORKDIR /frontend

COPY package.json package-lock.json docker-entrypoint.dev.sh ./
RUN chmod +x docker-entrypoint.dev.sh

EXPOSE 3000

ENTRYPOINT ["sh", "docker-entrypoint.dev.sh"]
