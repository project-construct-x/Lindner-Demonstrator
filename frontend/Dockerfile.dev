# Dev image — requires frontend to be initialized first (package.json with "dev" script).
# Source is bind-mounted at runtime; Vite HMR reloads the browser without container restart.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
